#!/bin/bash
# neko-kernel-helper: Helper privilegiado ejecutado via pkexec
# Provee operaciones seguras de sistema para Neko Kernel Manager en Void Linux

set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
umask 022

# Funciones de validación estricta (Sanitización contra inyección y traversal)
validate_pkg_name() {
    local pkg="$1"
    if [[ ! "$pkg" =~ ^[a-zA-Z0-9_#+.-]+$ ]] || [[ "$pkg" == -* ]]; then
        echo "Error de seguridad: Nombre de paquete inválido o potencialmente peligroso: '$pkg'" >&2
        return 1
    fi
    return 0
}

validate_version() {
    local ver="$1"
    if [[ ! "$ver" =~ ^[a-zA-Z0-9_.-]+$ ]] || [[ "$ver" == -* ]] || [[ "$ver" == *".."* ]] || [[ "$ver" == *"/"* ]]; then
        echo "Error de seguridad: Versión inválida o potencialmente peligrosa: '$ver'" >&2
        return 1
    fi
    return 0
}

ensure_not_running_version() {
    local ver="$1"
    local running
    running="$(uname -r 2>/dev/null || true)"
    if [ -n "$running" ] && [ "$ver" = "$running" ]; then
        echo "Error de seguridad: No se puede eliminar el kernel actualmente en ejecución ($running)." >&2
        return 1
    fi
    return 0
}

find_grub_mkconfig() {
    for cmd in grub-mkconfig grub2-mkconfig; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "$cmd"
            return 0
        fi
    done
    return 1
}

find_grub_editenv() {
    for cmd in grub-editenv grub2-editenv; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "$cmd"
            return 0
        fi
    done
    return 1
}

# Descubre todos los grub.cfg reales en /boot y /boot/efi sin sobrescribir stubs configfile
find_grub_cfgs() {
    local root="${1:-}"
    local seen_ids=""
    local found_any=0
    local cand dev_inode
    local -a candidates=(
        "${root}/boot/grub/grub.cfg"
        "${root}/boot/grub2/grub.cfg"
        "${root}/boot/efi/grub/grub.cfg"
        "${root}/boot/efi/grub2/grub.cfg"
        "${root}/efi/grub/grub.cfg"
    )
    local efi_cfg efi_dir
    for efi_cfg in "${root}/boot/efi/EFI/"*/grub.cfg; do
        [ -f "$efi_cfg" ] || continue
        efi_dir="${efi_cfg%/*}"
        efi_dir="${efi_dir##*/}"
        case "${efi_dir,,}" in
            void*|neko*|grub*) ;;
            *) continue ;;
        esac
        if grep -qE '(### BEGIN /etc/grub\.d/|automatically generated by grub-mkconfig)' "$efi_cfg" 2>/dev/null \
           && ! grep -Eq '^[[:space:]]*configfile[[:space:]]' "$efi_cfg" 2>/dev/null; then
            candidates+=("$efi_cfg")
        fi
    done

    for cand in "${candidates[@]}"; do
        [ -f "$cand" ] || continue
        dev_inode=$(stat -Lc '%d:%i' "$cand" 2>/dev/null || echo "$cand")
        case " $seen_ids " in
            *" $dev_inode "*) continue ;;
        esac
        seen_ids="$seen_ids $dev_inode"
        echo "$cand"
        found_any=1
    done

    if [ "$found_any" -eq 0 ]; then
        if [ -d "${root}/boot/efi/grub" ] && [ ! -d "${root}/boot/grub" ]; then
            echo "${root}/boot/efi/grub/grub.cfg"
        else
            echo "${root}/boot/grub/grub.cfg"
        fi
    fi
}

regenerate_grub_cfgs() {
    local mkconfig
    mkconfig=$(find_grub_mkconfig || true)
    [ -n "$mkconfig" ] || return 0
    local cfg
    while IFS= read -r cfg; do
        [ -n "$cfg" ] && [ -f "$cfg" ] || continue
        "$mkconfig" -o "$cfg" || true
    done < <(find_grub_cfgs)
}

find_grub_entry() {
    local cfg="$1"
    local kver="$2"
    [ -f "$cfg" ] || return 0
    awk -v kver="$kver" '
        function extract_id(s,    rest, q) {
            if (match(s, /(\$menuentry_id_option|--id)[[:space:]]+['\''"][^'\''"]+['\''"]/)) {
                rest = substr(s, RSTART, RLENGTH)
                if (match(rest, /['\''"][^'\''"]+['\''"]/)) {
                    q = substr(rest, RSTART + 1, RLENGTH - 2)
                    return q
                }
            }
            return ""
        }
        BEGIN { depth = 0; cur_sub = ""; cur_sub_id = ""; sub_depth = -1 }
        {
            line = $0
            if (line ~ /^[[:space:]]*submenu[[:space:]]/ && match(line, /['\''"][^'\''"]+['\''"]/)) {
                cur_sub = substr(line, RSTART + 1, RLENGTH - 2)
                cur_sub_id = extract_id(line)
                sub_depth = depth
            }
            if (line ~ /^[[:space:]]*menuentry[[:space:]]/ && tolower(line) !~ /recovery/ && match(line, /['\''"][^'\''"]+['\''"]/)) {
                entry = substr(line, RSTART + 1, RLENGTH - 2)
                idx = index(entry, kver)
                if (idx > 0) {
                    before_ok = (idx == 1) || (substr(entry, idx - 1, 1) ~ /[^[:alnum:]._-]/)
                    after_pos = idx + length(kver)
                    after_ok = (after_pos > length(entry)) || (substr(entry, after_pos, 1) ~ /[^[:alnum:]._-]/)
                    if (before_ok && after_ok) {
                        entry_id = extract_id(line)
                        ent_tok = (entry_id != "") ? entry_id : entry
                        if (cur_sub != "") {
                            sub_tok = (cur_sub_id != "") ? cur_sub_id : cur_sub
                            print sub_tok ">" ent_tok
                        } else {
                            print ent_tok
                        }
                        exit
                    }
                }
            }
            n_open = gsub(/\{/, "{", line)
            n_close = gsub(/\}/, "}", line)
            depth += n_open - n_close
            if (sub_depth >= 0 && n_close > 0 && depth <= sub_depth) {
                cur_sub = ""
                cur_sub_id = ""
                sub_depth = -1
            }
        }
    ' "$cfg"
}

execute_action() {
    local ACTION="${1:-}"
    shift || true

    case "$ACTION" in
        install-kernel)
            local PKG="${1:-}"
            local HEADERS="${2:-}"
            validate_pkg_name "$PKG"
            if [ -n "$HEADERS" ]; then
                validate_pkg_name "$HEADERS"
            fi

            echo "Instalando kernel: $PKG"
            xbps-install -y "$PKG"
            if [ -n "$HEADERS" ]; then
                echo "Instalando paquetes de cabeceras: $HEADERS"
                xbps-install -y "$HEADERS" || true
            fi
            ;;

        remove-kernel)
            if [ $# -eq 0 ]; then
                echo "Error: Paquetes no especificados." >&2
                return 1
            fi
            local running_kernel owner_pkg owner_name
            running_kernel="$(uname -r 2>/dev/null || true)"
            owner_pkg=""
            if [ -n "$running_kernel" ] && command -v xbps-query >/dev/null 2>&1; then
                owner_pkg="$(xbps-query -o "/boot/vmlinuz-${running_kernel}" 2>/dev/null | head -n 1 | cut -d: -f1 || true)"
                if [ -z "$owner_pkg" ]; then
                    owner_pkg="$(xbps-query -o "/usr/lib/modules/${running_kernel}/modules.dep" 2>/dev/null | head -n 1 | cut -d: -f1 || true)"
                fi
            fi
            owner_name="${owner_pkg%-*}"

            for pkg in "$@"; do
                validate_pkg_name "$pkg"
                if [ -n "$owner_name" ] && [ "$pkg" = "$owner_name" ]; then
                    echo "Error de seguridad: No se puede desinstalar el paquete propietario del kernel activo ($owner_pkg)." >&2
                    return 1
                fi
            done

            echo "Eliminando kernel(s): $*"
            xbps-remove -Rfy "$@" || xbps-remove -RFy "$@"
            ;;

        reconfigure-kernel)
            local PKG="${1:-}"
            validate_pkg_name "$PKG"
            echo "Reconfigurando kernel: $PKG"
            xbps-reconfigure -f "$PKG"
            ;;

        reconfigure-manual)
            local NAME="${1:-}"
            local VER="${2:-$NAME}"
            validate_pkg_name "$NAME"
            validate_version "$VER"

            echo "Reconfigurando manualmente kernel: $NAME ($VER)"
            if [ -x /etc/kernel.d/post-install/10-dkms ]; then
                /etc/kernel.d/post-install/10-dkms "$NAME" "$VER"
            fi
            if command -v dracut >/dev/null 2>&1; then
                dracut --force "/boot/initramfs-${VER}.img" "$VER"
            fi
            regenerate_grub_cfgs
            ;;

        vkpurge-rm)
            local VER="${1:-}"
            validate_version "$VER"
            ensure_not_running_version "$VER"

            echo "Purgando versión antigua con vkpurge: $VER"
            vkpurge rm "$VER" || {
                echo "vkpurge falló; limpiando archivos residuales en /boot y /lib/modules..."
                rm -f "/boot/vmlinuz-${VER}" "/boot/initramfs-${VER}.img" "/boot/initrd.img-${VER}" \
                      "/boot/config-${VER}" "/boot/System.map-${VER}" \
                      "/boot/vmlinuz-${VER}.old" "/boot/initramfs-${VER}.old.img"
                rm -rf "/usr/lib/modules/${VER}" "/lib/modules/${VER}"
                regenerate_grub_cfgs
            }
            ;;

        vkpurge-rm-all)
            echo "Purgando todos los kernels no utilizados con vkpurge..."
            vkpurge rm all
            regenerate_grub_cfgs
            ;;

        manual-remove)
            local VER="${1:-}"
            validate_version "$VER"
            ensure_not_running_version "$VER"

            echo "Eliminando archivos del kernel manual: $VER"
            rm -f "/boot/vmlinuz-${VER}" "/boot/initramfs-${VER}.img" "/boot/initrd.img-${VER}" \
                  "/boot/config-${VER}" "/boot/System.map-${VER}" \
                  "/boot/vmlinuz-${VER}.old" "/boot/initramfs-${VER}.old.img"
            rm -rf "/usr/lib/modules/${VER}" "/lib/modules/${VER}"
            regenerate_grub_cfgs
            ;;

        set-default-kernel)
            local TARGET_VER="${1:-}"
            validate_version "$TARGET_VER"
            echo "Configurando kernel por defecto en GRUB: $TARGET_VER"

            if [ ! -f /etc/default/grub ]; then
                echo "Error: No se encontró /etc/default/grub." >&2
                return 1
            fi

            local GRUB_EDITENV
            GRUB_EDITENV=$(find_grub_editenv || true)
            if [ -z "$GRUB_EDITENV" ]; then
                echo "Error: No se encontró grub-editenv ni grub2-editenv." >&2
                return 1
            fi
            local GRUB_MKCONFIG
            GRUB_MKCONFIG=$(find_grub_mkconfig || true)

            # 1. Asegurar GRUB_DEFAULT=saved en /etc/default/grub y detectar si cambió
            local NEED_GLOBAL_MKCONFIG=0
            local PREV_DEFAULT
            PREV_DEFAULT=$(grep -E '^[[:space:]]*GRUB_DEFAULT=' /etc/default/grub | tail -n 1 | cut -d= -f2- | sed 's/[[:space:]]*#.*//' | tr -d '"'\''[:space:]' || true)
            if [ "$PREV_DEFAULT" != "saved" ]; then
                NEED_GLOBAL_MKCONFIG=1
            fi
            if grep -Eq '^#?[[:space:]]*GRUB_DEFAULT=' /etc/default/grub; then
                sed -i --follow-symlinks -E 's/^#?[[:space:]]*GRUB_DEFAULT=.*/GRUB_DEFAULT=saved/' /etc/default/grub
            else
                echo 'GRUB_DEFAULT=saved' >> /etc/default/grub
            fi

            # 2. Actualizar cada configuración real de GRUB (/boot/grub, /boot/efi/grub, etc.)
            local UPDATED_COUNT=0
            local LAST_ENTRY=""
            local GRUB_CFG NEED_CFG_MKCONFIG FOUND GRUB_ENV
            while IFS= read -r GRUB_CFG; do
                [ -n "$GRUB_CFG" ] || continue
                NEED_CFG_MKCONFIG="$NEED_GLOBAL_MKCONFIG"
                if [ ! -f "$GRUB_CFG" ]; then
                    NEED_CFG_MKCONFIG=1
                elif ! grep -Eq '^[[:space:]]*set[[:space:]]+default=["'\'']?\$\{saved_entry\}["'\'']?' "$GRUB_CFG" 2>/dev/null; then
                    NEED_CFG_MKCONFIG=1
                fi

                if [ "$NEED_CFG_MKCONFIG" -eq 1 ]; then
                    if [ -z "$GRUB_MKCONFIG" ]; then
                        echo "Aviso: grub-mkconfig no disponible para actualizar $GRUB_CFG." >&2
                        [ -f "$GRUB_CFG" ] || continue
                    else
                        echo "Actualizando $GRUB_CFG para habilitar GRUB_DEFAULT=saved..."
                        mkdir -p "${GRUB_CFG%/*}"
                        if ! "$GRUB_MKCONFIG" -o "$GRUB_CFG"; then
                            echo "Aviso: No se pudo regenerar $GRUB_CFG." >&2
                            [ -f "$GRUB_CFG" ] || continue
                        fi
                    fi
                fi

                FOUND=$(find_grub_entry "$GRUB_CFG" "$TARGET_VER")
                if [ -z "$FOUND" ] && [ "$NEED_CFG_MKCONFIG" -eq 0 ] && [ -n "$GRUB_MKCONFIG" ]; then
                    echo "Entrada no encontrada en $GRUB_CFG; regenerando configuración de GRUB..."
                    if "$GRUB_MKCONFIG" -o "$GRUB_CFG"; then
                        FOUND=$(find_grub_entry "$GRUB_CFG" "$TARGET_VER")
                    fi
                fi

                if [ -z "$FOUND" ]; then
                    echo "Aviso: No se encontró entrada para $TARGET_VER en $GRUB_CFG." >&2
                    continue
                fi

                # 3. Aplicar en el grubenv hermano (limpiando next_entry y prev_saved_entry)
                GRUB_ENV="${GRUB_CFG%/*}/grubenv"
                if [ ! -f "$GRUB_ENV" ]; then
                    "$GRUB_EDITENV" "$GRUB_ENV" create || {
                        echo "Aviso: No se pudo crear $GRUB_ENV." >&2
                        continue
                    }
                fi
                "$GRUB_EDITENV" "$GRUB_ENV" unset prev_saved_entry >/dev/null 2>&1 || true
                "$GRUB_EDITENV" "$GRUB_ENV" unset next_entry >/dev/null 2>&1 || true
                if "$GRUB_EDITENV" "$GRUB_ENV" set saved_entry="$FOUND"; then
                    echo "Kernel por defecto aplicado en $GRUB_ENV -> $FOUND"
                    LAST_ENTRY="$FOUND"
                    UPDATED_COUNT=$((UPDATED_COUNT + 1))
                else
                    echo "Aviso: Falló grub-editenv sobre $GRUB_ENV." >&2
                fi
            done < <(find_grub_cfgs)

            if [ "$UPDATED_COUNT" -eq 0 ]; then
                echo "Error: No se pudo establecer una entrada válida de GRUB en /boot ni /boot/efi para el kernel $TARGET_VER." >&2
                return 1
            fi
            echo "Kernel por defecto establecido exitosamente a: $LAST_ENTRY"
            ;;

        dkms-install)
            local MODULE="${1:-}"
            local VER="${2:-}"
            local KVER="${3:-}"
            validate_pkg_name "$MODULE"
            validate_version "$VER"
            validate_version "$KVER"

            echo "Instalando módulo DKMS: $MODULE $VER para kernel $KVER"
            dkms install -m "$MODULE" -v "$VER" -k "$KVER"
            if command -v dracut >/dev/null 2>&1; then
                echo "Regenerando initramfs con Dracut..."
                dracut --force "/boot/initramfs-${KVER}.img" "$KVER" || true
            fi
            ;;

        dkms-remove)
            local MODULE="${1:-}"
            local VER="${2:-}"
            local KVER="${3:-}"
            validate_pkg_name "$MODULE"
            validate_version "$VER"
            if [ -n "$KVER" ]; then
                validate_version "$KVER"
                echo "Eliminando módulo DKMS: $MODULE $VER para kernel $KVER"
                dkms remove -m "$MODULE" -v "$VER" -k "$KVER"
            else
                echo "Eliminando módulo DKMS: $MODULE $VER (todas las versiones)"
                dkms remove -m "$MODULE" -v "$VER" --all
            fi
            ;;

        dkms-autoinstall)
            local KVER="${1:-}"
            validate_version "$KVER"

            echo "Autoinstalando módulos DKMS para kernel activo: $KVER"
            dkms autoinstall -k "$KVER"
            if command -v dracut >/dev/null 2>&1; then
                echo "Regenerando initramfs con Dracut..."
                dracut --force "/boot/initramfs-${KVER}.img" "$KVER" || true
            fi
            ;;

        nvidia-dkms-install)
            local MODULE="${1:-}"
            local VER="${2:-}"
            validate_pkg_name "$MODULE"
            if [[ "$MODULE" != nvidia* ]]; then
                echo "Error de seguridad: Módulo NVIDIA DKMS inválido: '$MODULE'" >&2
                return 1
            fi
            validate_version "$VER"
            shift 2 || true
            for k in "$@"; do
                validate_version "$k"
                echo "Forzando instalación DKMS de $MODULE ($VER) para kernel: $k"
                dkms install -m "$MODULE" -v "$VER" -k "$k" || true
                if command -v dracut >/dev/null 2>&1; then
                    dracut --force "/boot/initramfs-${k}.img" "$k" || true
                fi
            done
            ;;

        *)
            echo "Error: Acción no reconocida: $ACTION" >&2
            return 1
            ;;
    esac
}

MODE="${1:-}"
shift || true

if [ "$MODE" = "--daemon" ]; then
    # Mantener el pipe de comandos privado exclusivamente en FD 3; el nonce se lee
    # por el pipe (nunca por argv en /proc/*/cmdline) y los subprocesos no heredan FD 3.
    exec 3<&0
    if ! IFS= read -r -u 3 NONCE; then
        echo "Error de seguridad: Nonce de sesión ausente." >&2
        exit 1
    fi
    NONCE="${NONCE%$'\r'}"
    if [[ ! "$NONCE" =~ ^[a-fA-F0-9]{16,64}$ ]]; then
        echo "Error de seguridad: Nonce de sesión inválido." >&2
        exit 1
    fi

    echo "__NEKO_READY_${NONCE}__"

    while IFS= read -r -u 3 line; do
        [ -z "$line" ] && continue

        IFS=$'\t' read -r -a CMD_PARTS <<< "$line"
        CMD_ACTION="${CMD_PARTS[0]:-}"

        if [ "$CMD_ACTION" = "quit" ]; then
            break
        fi

        if [ "${#CMD_PARTS[@]}" -gt 32 ]; then
            echo "Error de seguridad: Demasiados argumentos en el comando." >&2
            echo "__NEKO_DONE_${NONCE}__:1"
            continue
        fi

        set +e
        (
            set -euo pipefail
            execute_action "${CMD_PARTS[@]}"
        ) </dev/null 3<&- 2>&1
        rc=$?
        set -e
        echo "__NEKO_DONE_${NONCE}__:${rc}"
    done

    exec 3<&-
    exit 0
else
    execute_action "$MODE" "$@"
fi
